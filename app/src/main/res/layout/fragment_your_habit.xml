<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimary">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:layout_marginTop="30dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Your Habit"
            android:textColor="@color/purple"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Date Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <TextView
                android:id="@+id/tv_date_1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="1\nMar"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/date_tab_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_date_2"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="29\nFeb"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="14sp"
                android:background="@drawable/date_tab_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_date_3"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="28\nFeb"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="14sp"
                android:background="@drawable/date_tab_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_date_4"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="27\nFeb"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="14sp"
                android:background="@drawable/date_tab_background"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tv_date_5"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="26\nFeb"
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="14sp"
                android:background="@drawable/date_tab_background" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- Today Habit Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today Habit"
        android:textColor="@color/purple"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp" />

    <!-- Habits RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_habits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp" />

</LinearLayout>
